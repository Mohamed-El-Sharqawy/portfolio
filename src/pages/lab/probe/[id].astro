---
/**
 * Lighthouse probe: the real home page plus exactly one candidate, placed in the hero
 * (above the fold, the worst case for FCP/LCP). `/lab/probe/none/` is the control.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Companies from '../../../components/Companies.astro';
import Work from '../../../components/Work.astro';
import Agents from '../../../components/Agents.astro';
import Experience from '../../../components/Experience.astro';
import GitHub from '../../../components/GitHub.astro';
import Stack from '../../../components/Stack.astro';
import Contact from '../../../components/Contact.astro';
import LabShape from '../../../shapes/ShaderShape.astro';
import { candidates } from '../../../lab/shapes/candidates';

export const getStaticPaths = (() =>
  ['none', ...candidates.map((c) => c.id)].map((id) => ({
    params: { id },
  }))) satisfies GetStaticPaths;

const { id } = Astro.params;
---

<Base title={`Probe: ${id}`} noindex>
  <Hero />
  <Companies />
  <Work />
  <Agents />
  <Experience />
  <GitHub />
  <Stack />
  <Contact />
  {id !== 'none' && (
    <div class="shapes probe" aria-hidden="true">
      <LabShape id={id} tone="paper" class="probe-shape" probe />
    </div>
  )}
</Base>

<style>
  .probe {
    --s: 280px;
    width: var(--s);
    height: var(--s);
    inset: auto;
    top: calc(var(--header-h) + 60px);
    right: 420px;
  }
  @media (max-width: 640px) {
    .probe {
      top: calc(var(--header-h) + 150px);
      right: 16px;
    }
    .probe {
      --s: 120px;
    }
  }
</style>
