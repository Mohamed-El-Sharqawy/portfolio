---
/**
 * Shape lab: candidate replacements for the decorative CSS shapes, compared on
 * every section background at desktop and mobile size. Not linked, noindex,
 * excluded from the sitemap. Numbers come from results.json (measured, not guessed).
 */
import Base from '../../layouts/Base.astro';
import LabShape from '../../shapes/ShaderShape.astro';
import { candidates, type Tone } from '../../lab/shapes/candidates';
import results from '../../lab/shapes/results.json';

interface R {
  jsGz?: number;
  assetGz?: number;
  htmlGz?: number;
  mobile?: { perf: number; tbt: number; lcp: number; cls: number };
  desktop?: { perf: number; tbt: number; lcp: number; cls: number };
  frameMs?: number;
  mainMs?: number;
  fidelity?: string;
  reco?: string;
}
const res = results as Record<string, R>;
const tones: { tone: Tone; label: string }[] = [
  { tone: 'paper', label: 'Paper #F7F8FA' },
  { tone: 'dark', label: 'Dark #0E1116' },
  { tone: 'accent', label: 'Cobalt #2F4BFF' },
];
const kb = (b?: number) => (b === undefined ? '—' : b === 0 ? '0' : `${(b / 1024).toFixed(1)} KB`);
const ms = (v?: number) => (v === undefined ? '—' : `${Math.round(v)} ms`);
const groupLabel = { css: 'CSS / SVG', canvas: 'Canvas 2D', webgl: 'WebGL', video: 'Video' };
---

<Base title="Shape lab" description="Internal: decorative shape candidates." noindex>
  <section class="lab" aria-labelledby="lab-h">
    <div class="wrap">
      <p class="eyebrow">Lab · not linked from the site</p>
      <h1 id="lab-h" class="h2">
        Shader-look shapes
      </h1>
      <p class="lede">
        {candidates.length} candidates to replace the CSS shapes. Each one is shown live on the
        three section backgrounds, at desktop size (280px) and mobile size (120px). Costs come from
        Lighthouse runs on the home page with only that shape added to the hero (median of 3), plus
        a 10 s mobile trace at 4× CPU throttle.
      </p>
      <p class="lede">
        Caveats: the probe runs placed the shape at 280px on mobile too (bigger than the real site),
        and the shapes then shipped an AVIF poster in the HTML, which became the mobile LCP element
        (LCP 1.65–1.8 s vs 1.0 s). Since fixed: canvas/WebGL shapes only use the poster without JS
        or without OffscreenCanvas/WebGL, and the contour uses an SVG &lt;use&gt;. The real home and
        case-study pages now score 100/100/100/100 with the hero h1 as LCP. WebGL frame costs are
        from SwiftShader (software GL), so treat them as an upper bound.
      </p>

      <div class="table-wrap" role="region" aria-label="Comparison table" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Candidate</th>
              <th scope="col">Technique</th>
              <th scope="col">JS gz</th>
              <th scope="col">Assets</th>
              <th scope="col">Mobile perf</th>
              <th scope="col">TBT (m)</th>
              <th scope="col">LCP (m)</th>
              <th scope="col">CLS</th>
              <th scope="col">Frame cost</th>
              <th scope="col">Fidelity</th>
              <th scope="col">Reco</th>
            </tr>
          </thead>
          <tbody>
            {candidates.map((c) => {
              const r = res[c.id] ?? {};
              return (
                <tr>
                  <th scope="row">
                    <a href={`#${c.id}`}>{c.name}</a>
                  </th>
                  <td>{groupLabel[c.group]}</td>
                  <td>{kb(r.jsGz)}</td>
                  <td>{kb(r.assetGz)}</td>
                  <td>{r.mobile?.perf ?? '—'}</td>
                  <td>{ms(r.mobile?.tbt)}</td>
                  <td>{ms(r.mobile?.lcp)}</td>
                  <td>{r.mobile ? r.mobile.cls.toFixed(3) : '—'}</td>
                  <td>{r.frameMs === undefined ? '—' : `${r.frameMs.toFixed(1)} ms`}</td>
                  <td>{r.fidelity ?? '—'}</td>
                  <td>{r.reco ?? '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {candidates.map((c, n) => {
    const r = res[c.id] ?? {};
    return (
      <section class="cand" id={c.id} aria-labelledby={`${c.id}-h`}>
        <div class="wrap">
          <header class="head">
            <p class="mono num">
              {String(n + 1).padStart(2, '0')} · {groupLabel[c.group]}
            </p>
            <h2 id={`${c.id}-h`}>{c.name}</h2>
            <p class="note">{c.note}</p>
            <dl class="meta mono">
              <div>
                <dt>Technique</dt>
                <dd>{c.technique}</dd>
              </div>
              <div>
                <dt>Would replace</dt>
                <dd>{c.replaces}</dd>
              </div>
              <div>
                <dt>JS (gz)</dt>
                <dd>{kb(r.jsGz)}</dd>
              </div>
              <div>
                <dt>Assets (gz / encoded)</dt>
                <dd>{kb(r.assetGz)}</dd>
              </div>
              <div>
                <dt>Lighthouse m / d</dt>
                <dd>
                  {r.mobile && r.desktop
                    ? `${r.mobile.perf} / ${r.desktop.perf} · TBT ${Math.round(r.mobile.tbt)} / ${Math.round(r.desktop.tbt)} ms · CLS ${r.mobile.cls.toFixed(3)}`
                    : 'not measured yet'}
                </dd>
              </div>
              <div>
                <dt>Frame cost (4× CPU, mobile)</dt>
                <dd>
                  {r.frameMs === undefined
                    ? 'not measured yet'
                    : `${r.frameMs.toFixed(1)} ms render · main thread ${ms(r.mainMs)}/s`}
                </dd>
              </div>
            </dl>
          </header>
          <div class="panels">
            {tones.map((t) => (
              <div class:list={['panel', `t-${t.tone}`]}>
                <p class="mono plabel">{t.label}</p>
                <div class="shapes stage" aria-hidden="true">
                  <LabShape id={c.id} size={280} tone={t.tone} />
                  <LabShape id={c.id} size={120} tone={t.tone} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Base>

<style>
  .lab {
    padding: 72px 0 40px;
  }
  .lede {
    max-width: 68ch;
    color: var(--body);
    margin: 20px 0 32px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.8125rem;
    font-family: var(--mono);
  }
  th,
  td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line-soft);
    white-space: nowrap;
  }
  thead th {
    color: var(--muted);
    font-weight: 500;
  }
  tbody th a {
    color: var(--accent);
  }
  .cand {
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .num {
    color: var(--accent);
    font-size: 0.8125rem;
  }
  h2 {
    font-size: 2rem;
    letter-spacing: -0.03em;
    margin: 6px 0 8px;
  }
  .note {
    color: var(--body);
    max-width: 70ch;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 24px;
    font-size: 0.75rem;
    margin: 20px 0 24px;
  }
  .meta dt {
    color: var(--muted);
  }
  .meta dd {
    margin: 2px 0 0;
    color: var(--ink);
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .panel {
    position: relative;
    border-radius: var(--radius);
    padding: 14px;
    min-width: 0;
    overflow: hidden;
  }
  .t-paper {
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .t-dark {
    background: var(--dark);
    color: var(--muted-dark);
  }
  .t-accent {
    background: var(--accent);
    color: #e6e9ff;
  }
  .plabel {
    font-size: 0.6875rem;
    margin: 0 0 8px;
  }
  /* .shapes is the global decorative layer (pause hook); lay it out in-flow here. */
  .panel .stage {
    position: relative;
    inset: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 296px;
  }
  @media (max-width: 1100px) {
    .panels {
      grid-template-columns: minmax(0, 1fr);
    }
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .meta {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel .stage :global(.lab-shape:first-child) {
      --s: 220px;
    }
  }
</style>
