---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Mohamed Ahmed" description="This page doesn’t exist." noindex>
  <section class="nf" aria-labelledby="nf-h">
    <div class="wrap">
      <p class="eyebrow">[404]</p>
      <h1 id="nf-h" class="title">
        Nothing shipped here<span class="dot">.</span>
      </h1>
      <p class="body">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="ctas">
        <a href="/" class="btn btn--accent">
          Back to the homepage
        </a>
        <a href="/#work" class="btn btn--ghost">
          Selected work
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 120px 0 160px;
  }
  .title {
    margin-top: 20px;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-weight: 600;
    max-width: 14ch;
  }
  .dot {
    color: var(--accent);
  }
  .body {
    margin-top: 28px;
    color: var(--body);
  }
  .ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .nf {
      padding: 64px 0 96px;
    }
  }
</style>
