---
import { profile } from '../data/profile';
---
<section id="contact" class="panel panel--room" aria-labelledby="contact-title" data-lenis-prevent>
  <h2 id="contact-title" class="h-room" tabindex="-1">Contact</h2>
  <div class="letter sheet">
    <p class="letter__headline">{profile.contactHeadline}</p>
    <p>
      Email:{' '}
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <ul class="links">
      <li><a href={profile.links.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
    </ul>
    <p class="meta">{profile.location} · {profile.availability}</p>
  </div>
</section>
