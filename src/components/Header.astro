---
import { navLinks, profile } from '../data/site';
import ShaderShape from '../shapes/ShaderShape.astro';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo">
      MA<span class="slash">/</span>portfolio<span class="sr-only"> — {profile.name}, home</span>
    </a>
    <nav aria-label="Primary" class="navlinks">
      {navLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a href={profile.cvUrl} class="cv" target="_blank" rel="noopener">
        CV<span class="sr-only"> (PDF, opens in a new tab)</span>
      </a>
      <a href="/#contact" class="contact">
        Contact
      </a>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-word mono" aria-hidden="true">
          Menu
        </span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="l1" d="M4 8h16"></path>
          <path class="l2" d="M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Full-screen mobile menu: fixed under the header bar, page behind is inert. -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    <div class="menu-inner">
      <p class="menu-label mono">Navigation</p>
      <ul role="list" class="menu-links">
        {navLinks.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href}>
              <span class="idx mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="txt">
                <span class="name">{l.label}</span>
                <span class="note">{l.note}</span>
              </span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="menu-foot" style={`--i:${navLinks.length}`}>
        {/* Decorative ribbon in the free space above the actions; starts only when the menu opens. */}
        <ShaderShape id="gl-ribbon" tone="paper" class="menu-ribbon" />
        <p class="menu-label mono">
          <span class="dot" aria-hidden="true"></span>
          {profile.availabilityShort}
        </p>
        <div class="menu-ctas">
          <a href="/#contact" class="btn btn--accent">
            Start a conversation <span aria-hidden="true">→</span>
          </a>
          <a href={profile.cvUrl} class="btn" target="_blank" rel="noopener">
            View CV <span aria-hidden="true">↗</span>
            <span class="sr-only"> (PDF, opens in a new tab)</span>
          </a>
        </div>
        <ul role="list" class="menu-meta mono">
          <li>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <a href={profile.whatsapp} target="_blank" rel="noopener">
              WhatsApp <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={profile.linkedin} rel="noopener me">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href={profile.github} rel="noopener me">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (header && btn && menu) {
    // Everything outside the header is made inert while the menu is open, so focus,
    // clicks and screen readers stay inside the header + menu (no custom focus trap).
    const outside = [...document.body.children].filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el !== header && !el.contains(header),
    );
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      const word = btn.querySelector('.menu-word');
      if (word) word.textContent = open ? 'Close' : 'Menu';
      menu.hidden = !open;
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      outside.forEach((el) => (el.inert = open));
    };
    btn.addEventListener('click', () => set(menu.hidden !== false));
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 248, 250, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* backdrop-filter would make the header the containing block of the fixed menu. */
  .site-header.is-open {
    background: var(--paper);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .slash {
    color: var(--accent);
  }
  .navlinks {
    display: flex;
    gap: 32px;
    font-size: 0.9375rem;
  }
  .navlinks a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--body);
  }
  .navlinks a:hover {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cv,
  .contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
  }
  .cv {
    padding: 0 14px;
  }
  .contact {
    padding: 0 18px;
    font-weight: 600;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-sm);
  }
  .contact:hover {
    background: var(--accent);
    color: var(--white);
  }

  /* ---------- Menu button ---------- */
  .menu-btn {
    display: none;
    gap: 10px;
    height: 44px;
    padding: 0 12px 0 14px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-word {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .menu-btn[aria-expanded='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .menu-btn path {
    transition: transform 0.2s ease;
    transform-origin: 12px 12px;
  }
  .menu-btn[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---------- Full-screen menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 9;
    height: calc(100dvh - var(--header-h));
    background: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 28px var(--gutter) max(28px, env(safe-area-inset-bottom));
  }
  .menu-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .menu-links {
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .menu-links a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .idx {
    font-size: 0.75rem;
    color: var(--accent);
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .name {
    font-size: 2rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .arrow {
    font-size: 1.25rem;
    color: var(--muted);
    transition: transform 0.15s ease;
  }
  .menu-links a:hover .name,
  .menu-links a:focus-visible .name {
    color: var(--accent);
  }
  .menu-links a:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  .menu-foot {
    position: relative;
    margin-top: auto;
    padding-top: 32px;
  }
  .menu-foot :global(.menu-ribbon) {
    --s: 190px;
    right: -28px;
    bottom: calc(100% - 40px);
    z-index: -1;
  }
  /* No free space on short screens: skip it rather than sit under the links. */
  @media (max-height: 760px) {
    .menu-foot :global(.menu-ribbon) {
      display: none;
    }
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .menu-ctas {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }
  .menu-ctas .btn {
    width: 100%;
  }
  .menu-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 20px 0 0;
    padding: 0;
    font-size: 0.8125rem;
  }
  .menu-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--body);
  }
  .menu-meta a:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-fade 0.2s ease both;
    }
    .mobile-menu:not([hidden]) .menu-links li,
    .mobile-menu:not([hidden]) .menu-foot {
      animation: menu-in 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 45ms + 60ms);
    }
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
  }

  @media (max-width: 960px) {
    .navlinks,
    .cv,
    .contact {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 640px) {
    .name {
      font-size: 1.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-btn path,
    .arrow {
      transition: none;
    }
  }
</style>
