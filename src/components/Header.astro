---
import { navLinks, profile } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo">
      MA<span class="slash">/</span>portfolio<span class="sr-only"> — {profile.name}, home</span>
    </a>
    <nav aria-label="Primary" class="navlinks">
      {navLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a href={profile.cvUrl} class="cv">
        CV<span class="sr-only"> (PDF)</span>
      </a>
      <a href="/#contact" class="contact">
        Contact
      </a>
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="l1" d="M4 8h16"></path>
          <path class="l2" d="M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    <ul role="list">
      {navLinks.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
      <li>
        <a href={profile.cvUrl}>CV (PDF)</a>
      </li>
      <li>
        <a href="/#contact">Contact</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(menu.hidden !== false));
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 248, 250, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .slash {
    color: var(--accent);
  }
  .navlinks {
    display: flex;
    gap: 32px;
    font-size: 0.9375rem;
  }
  .navlinks a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--body);
  }
  .navlinks a:hover {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cv,
  .contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
  }
  .cv {
    padding: 0 14px;
  }
  .contact {
    padding: 0 18px;
    font-weight: 600;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-sm);
  }
  .contact:hover {
    background: var(--accent);
    color: var(--white);
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--ink);
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-btn path {
    transition: transform 0.2s ease;
    transform-origin: 12px 12px;
  }
  .menu-btn[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .mobile-menu ul {
    margin: 0;
    padding: 8px var(--gutter) 16px;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 960px) {
    .navlinks,
    .cv,
    .contact {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-btn path {
      transition: none;
    }
  }
</style>
