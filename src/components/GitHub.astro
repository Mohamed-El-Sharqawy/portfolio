---
import { getGithubSnapshot, toWeeks } from '../lib/github';
import { profile } from '../data/site';

const snapshot = await getGithubSnapshot();
const weeks = snapshot ? toWeeks(snapshot.days) : [];
const fmt = new Intl.NumberFormat('en-US');
const spanLabel = snapshot?.span === '90d' ? 'last 90 days' : 'last 12 months';
const summary = snapshot
  ? `${fmt.format(snapshot.total)} contributions in the ${spanLabel}, longest streak ${snapshot.longestStreak} days.`
  : '';
const dateFmt = (iso: string, withYear = false) =>
  new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    ...(withYear && { year: 'numeric' }),
    timeZone: 'UTC',
  });
const built = snapshot ? dateFmt(snapshot.generatedAt, true) : '';
// Commit times in the owner's timezone (Dubai, GST = UTC+4), independent of the build server.
const TZ = 'Asia/Dubai';
const commitDay = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: TZ });
const commitTime = (iso: string) =>
  new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ });

// Month label above the first week column of each month (skip a partial first month).
const monthLabels = weeks.map((week, i) => {
  const first = week.find((d) => d !== null);
  if (!first) return '';
  const month = first.date.slice(0, 7);
  const prevFirst = weeks[i - 1]?.find((d) => d !== null);
  if (prevFirst && prevFirst.date.slice(0, 7) === month) return '';
  if (i === 0 && Number(first.date.slice(8, 10)) > 14) return '';
  // A label in the last two columns would overflow the grid.
  if (i >= weeks.length - 2) return '';
  return new Date(`${first.date}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    timeZone: 'UTC',
  });
});
const commits = snapshot?.commits ?? [];
---

<section aria-labelledby="gh-h" class="gh">
  <div class="wrap">
    <div class="card reveal">
      <div class="head">
        <div>
          <p class="eyebrow">[04] In the open</p>
          <h2 id="gh-h" class="title">
            GitHub, {spanLabel}
          </h2>
        </div>
        {snapshot && (
          <p class="mono totals">
            {fmt.format(snapshot.total)} contributions · {snapshot.longestStreak}-day streak
            {snapshot.publicRepos > 0 && ` · ${snapshot.publicRepos} repos`}
          </p>
        )}
      </div>
      {snapshot ? (
        <>
          <div
            class="scroller"
            tabindex="0"
            role="region"
            aria-label="Contribution heatmap (scrollable)"
          >
            <div class="grid" role="img" aria-label={summary}>
              {weeks.map((w, i) => (
                <div class="week">
                  <span class="month mono">{monthLabels[i]}</span>
                  {w.map((d) =>
                    d ? (
                      <span class={`c l${d.level}`} data-d={d.date} data-n={d.count} />
                    ) : (
                      <span class="c empty" />
                    ),
                  )}
                </div>
              ))}
            </div>
          </div>
          <div class="tip mono" aria-hidden="true" hidden></div>
          <div class="legend mono" aria-hidden="true">
            Less <span class="c l0" />
            <span class="c l1" />
            <span class="c l2" />
            <span class="c l3" />
            <span class="c l4" /> More
          </div>

          {commits.length > 0 && (
            <div class="commits">
              <h3 class="mono sub">
                Latest commits <span class="tz">· Dubai time (GST)</span>
              </h3>
              <ol role="list" class="feed">
                {commits.map((c) => (
                  <li class="row">
                    <time class="mono when" datetime={c.date}>
                      {commitDay(c.date)} <span class="at">· {commitTime(c.date)}</span>
                    </time>
                    <a class="mono repo" href={c.repoUrl} rel="noopener">
                      {c.repo}
                    </a>
                    <a class="msg" href={c.url} rel="noopener" title={c.message}>
                      {c.message}
                      <span class="sr-only"> — commit in {c.repo}</span>
                    </a>
                    <span class="mono sha" aria-hidden="true">
                      {c.sha}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <p class="mono foot">
            Pulled from{' '}
            <a href={profile.github} rel="noopener">
              github.com/{snapshot.username}
            </a>{' '}
            at build time · {built}
          </p>
        </>
      ) : (
        <p class="empty-state">
          GitHub activity wasn’t available when this page was built. See it live on{' '}
          <a href={profile.github} rel="noopener">
            github.com/{profile.githubUsername}
          </a>
          .
        </p>
      )}
    </div>
  </div>
</section>

<script>
  // Hover / tap a heatmap day: "3 contributions · Mon, 3 Nov 2026".
  const grid = document.querySelector<HTMLElement>('.gh .grid');
  const tip = document.querySelector<HTMLElement>('.gh .tip');
  if (grid && tip) {
    const day = new Intl.DateTimeFormat('en-GB', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    });
    const hide = () => (tip.hidden = true);
    grid.addEventListener('pointerover', (e) => {
      const cell = (e.target as Element).closest<HTMLElement>('[data-d]');
      if (!cell) return hide();
      const n = Number(cell.dataset.n);
      const date = day.format(new Date(`${cell.dataset.d}T00:00:00Z`));
      tip.innerHTML = `<strong>${n === 0 ? 'No' : n} contribution${n === 1 ? '' : 's'}</strong> · ${date}`;
      const r = cell.getBoundingClientRect();
      tip.hidden = false;
      // keep it inside the viewport horizontally
      const half = tip.offsetWidth / 2 + 8;
      const x = Math.min(Math.max(r.left + r.width / 2, half), innerWidth - half);
      tip.style.left = `${x}px`;
      tip.style.top = `${r.top}px`;
    });
    // Touch fires pointerleave right after the tap, so only a mouse hides on leave;
    // on touch the tip stays until the next tap elsewhere or a scroll.
    grid.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hide());
    document.addEventListener('pointerdown', (e) => {
      if (!grid.contains(e.target as Node)) hide();
    });
    addEventListener('scroll', hide, { passive: true });
    grid.closest('.scroller')?.addEventListener('scroll', hide, { passive: true });
  }
</script>

<style>
  .gh {
    padding: 0 0 112px;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    padding: 36px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }
  .title {
    margin-top: 10px;
    font-size: 2rem;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .totals,
  .foot {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .scroller {
    margin-top: 28px;
    overflow-x: auto;
  }
  .grid {
    direction: ltr;
    display: flex;
    gap: 4px;
    width: max-content;
  }
  .week {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .c {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 2px;
    background: var(--accent);
  }
  .l0 {
    background: var(--line-soft);
  }
  .l1 {
    opacity: 0.22;
  }
  .l2 {
    opacity: 0.45;
  }
  .l3 {
    opacity: 0.7;
  }
  .empty {
    background: transparent;
  }
  .month {
    height: 16px;
    font-size: 0.6875rem;
    line-height: 16px;
    color: var(--muted);
    white-space: nowrap;
    overflow: visible;
  }
  .legend {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .legend .c {
    width: 11px;
    height: 11px;
  }
  .commits {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .sub {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }
  .feed {
    margin: 12px 0 0;
  }
  .row {
    display: grid;
    grid-template-columns: 14ch minmax(0, 18ch) minmax(0, 1fr) 8ch;
    align-items: center;
    gap: 20px;
    min-height: 44px;
    border-bottom: 1px solid var(--line-soft);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .when,
  .sha {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .sha {
    text-align: right;
  }
  .when {
    white-space: nowrap;
  }
  .at {
    color: var(--ink);
  }
  .tz {
    font-weight: 400;
  }
  /* Heatmap day tooltip: one shared element, fixed so the scroller can't clip it. */
  .c[data-d] {
    cursor: default;
  }
  .c[data-d]:hover {
    outline: 1.5px solid var(--ink);
    outline-offset: 1px;
  }
  .tip {
    position: fixed;
    z-index: 5;
    left: 0;
    top: 0;
    padding: 6px 9px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 8px));
  }
  .tip strong {
    font-weight: 500;
    color: #fff;
  }
  .repo {
    font-size: 0.8125rem;
    color: var(--accent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 10px 0;
  }
  .repo:hover {
    color: var(--ink);
  }
  .msg {
    /* contain the absolutely positioned sr-only text inside the clipped link */
    position: relative;
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 10px 0;
  }
  .foot {
    margin-top: 16px;
    font-size: 0.75rem;
  }
  .foot a,
  .empty-state a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .empty-state {
    margin-top: 24px;
    color: var(--body);
  }
  @media (max-width: 640px) {
    .gh {
      padding-bottom: 64px;
    }
    .card {
      padding: 22px;
    }
    /* Narrow screens: whole year scrolls, starting at the most recent weeks */
    .scroller {
      direction: rtl;
    }
    .row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 12px;
      padding: 8px 0;
    }
    .msg {
      grid-column: 1 / -1;
      white-space: normal;
      padding: 2px 0 6px;
    }
    .repo {
      padding: 6px 0;
    }
    .sha {
      display: none;
    }
    .title {
      font-size: 1.625rem;
    }
    .c {
      width: 11px;
      height: 11px;
    }
    .grid,
    .week {
      gap: 3px;
    }
  }
</style>
