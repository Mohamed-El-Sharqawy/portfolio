---
import { getCollection } from 'astro:content';
import { profile } from '../data/site';

const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" aria-labelledby="exp-h" class="experience">
  <div class="wrap">
    <div class="g12 section-head">
      <p class="c-label eyebrow">[03] Experience</p>
      <h2 id="exp-h" class="c-body h2">
        Four teams, four countries.
      </h2>
    </div>
    <ol role="list" class="jobs">
      {jobs.map(({ data: j }) => (
        <li class="job reveal">
          <p class="period mono">{j.period}</p>
          <div>
            <h3 class="company">{j.company}</h3>
            <p class="role">
              {j.role} · {j.location}
            </p>
          </div>
          <div>
            <p class="summary">{j.summary}</p>
            <p class="stack mono">
              {j.stack
                .filter((s) => s !== 'TypeScript')
                .slice(0, 6)
                .join(' · ')}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <div class="edu">
      <p>{education.map(({ data: e }) => `${e.credential}, ${e.shortInstitution}`).join(' · ')}</p>
      <a href={profile.cvUrl} class="btn btn--ghost cv">
        Full CV (PDF) <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 128px 0 96px;
  }
  .jobs {
    margin: 64px 0 0;
    border-top: 2px solid var(--ink);
  }
  .job {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .period {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .company {
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .role {
    margin-top: 6px;
    color: var(--muted);
  }
  .summary {
    color: var(--body);
  }
  .stack {
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .edu {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    color: var(--muted);
  }
  .cv {
    min-height: 48px;
    padding: 0 20px;
  }
  @media (max-width: 960px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
  @media (max-width: 640px) {
    .experience {
      padding: 64px 0 56px;
    }
    .h2 {
      font-size: 2.5rem;
    }
    .jobs {
      margin-top: 32px;
    }
    .job {
      padding: 24px 0;
    }
    .company {
      font-size: 1.5rem;
    }
  }
</style>
