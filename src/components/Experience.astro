---
import { getCollection } from 'astro:content';
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---
<section id="experience" class="panel panel--room" aria-labelledby="experience-title" data-lenis-prevent>
  <h2 id="experience-title" class="h-room" tabindex="-1">Experience</h2>
  <ol class="timeline">
    {jobs.map(({ id, data }) => (
      <li class="timeline__item">
        <article
          class="job sheet"
          data-experience
          data-role={data.role}
          data-company={data.company}
          data-location={data.location}
          data-period={`${data.start} – ${data.end}`}
          aria-labelledby={`job-${id}`}
        >
          <h3 id={`job-${id}`} class="job__role">{data.role}</h3>
          <p class="job__company">{data.company} <span class="muted">({data.location})</span></p>
          <p class="job__period"><time>{data.start}</time> – <time>{data.end}</time></p>
          <p>{data.summary}</p>
        </article>
      </li>
    ))}
  </ol>
</section>
