---
import '../styles/global.css';
import { profile, seo, SITE_URL } from '../data/profile';

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(seo.ogImage, SITE_URL).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: SITE_URL,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dubai',
    addressCountry: 'AE',
  },
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Self-hosted WOFF2 subsets. Caveat is the display/LCP font, so it is preloaded. -->
    <link rel="preload" href="/fonts/caveat-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Caveat';
        src: url('/fonts/caveat-700.woff2') format('woff2');
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter-var.woff2') format('woff2');
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mohamed Ahmed, Full-Stack Engineer, sketched on paper" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!--
      Runs before first paint. Decides whether the paper intro is shown.
      Cheap feature check only; the real WebGL2 context test happens in boot.ts.
      ?flat (or the saved toggle choice) shows the plain HTML version; ?3d overrides the saved choice.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
        // View choice: ?flat / ?3d in the URL win; otherwise the toggle's saved choice.
        var q = location.search, pref = null;
        try { pref = localStorage.getItem('portfolio-view'); } catch (e) {}
        var flat = /[?&]flat\b/.test(q) || (pref === 'flat' && !/[?&](3d|force3d)\b/.test(q));
        if (flat) d.classList.add('flat-choice');
        else if ('WebGL2RenderingContext' in window) d.classList.add('try-3d');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
