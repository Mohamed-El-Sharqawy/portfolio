{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Hashed, content-addressed build assets (JS, fonts): cache forever.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# OG images and other static files: a day.
	@static path /og/* /icons/* /favicon.* /*.pdf
	header @static Cache-Control "public, max-age=86400"

	# HTML, sitemap, robots: always revalidate (content changes on rebuild).
	@html not path /_astro/* /og/* /icons/* /favicon.* /*.pdf
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# PWA: correct manifest type; the service worker must always revalidate
	# (covered by the HTML rule above) and may control the whole origin.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type application/manifest+json
	@sw path /sw.js
	header @sw Service-Worker-Allowed /

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
