{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Hashed, content-addressed build output (JS, CSS, images, wasm): cache forever.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Fonts, textures, models, OG image: fixed names, so a day + revalidation.
	@static path /fonts/* /textures/* /models/* /og.png /favicon.svg
	header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# HTML, sitemap, robots: always revalidate (content changes on rebuild).
	@html not path /_astro/* /fonts/* /textures/* /models/* /og.png /favicon.svg
	header @html Cache-Control "public, max-age=0, must-revalidate"

	file_server
}
